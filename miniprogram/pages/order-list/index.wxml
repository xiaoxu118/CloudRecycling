<!--订单列表-->
<view class="order-list">
  <!-- 搜索框 -->
  <view class="search-wrap">
    <image class="search-icon" src="/images/home/search.svg" mode="aspectFit" />
    <input
      class="search-input"
      placeholder="搜索订单号、地址、品类..."
      placeholder-class="search-placeholder"
      value="{{keyword}}"
      bind:input="onKeywordInput"
      bind:confirm="onKeywordConfirm"
      confirm-type="search"
    />
  </view>

  <!-- Tabs -->
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bind:tap="onTabChange"
    >
      <text class="tab-label">{{item.label}}</text>
      <text class="tab-count" wx:if="{{counts[item.key] > 0}}">{{counts[item.key]}}</text>
    </view>
  </view>

  <!-- 列表 -->
  <view class="list">
    <!-- 加载中（初次） -->
    <view wx:if="{{loading && !list.length}}" class="state-tip">加载中...</view>

    <!-- 加载失败 -->
    <view wx:elif="{{loadError && !list.length}}" class="empty">
      <text class="empty-text">{{loadError}}</text>
      <view class="retry-btn" bind:tap="retryLoad">重试</view>
    </view>

    <!-- 空态 -->
    <view wx:elif="{{!list.length && !loading}}" class="empty">
      <text class="empty-title">暂无订单</text>
      <text class="empty-desc">提交预约后，订单会显示在这里</text>
      <view class="go-btn" bind:tap="goCreate">去预约回收</view>
    </view>

    <!-- 订单卡片 -->
    <view
      wx:for="{{list}}"
      wx:key="_id"
      class="order-card"
      data-id="{{item._id}}"
      bind:tap="goDetail"
    >
      <!-- 订单号+状态 -->
      <view class="card-head">
        <text class="order-no">{{item.orderNo}}</text>
        <view class="status-tag status-{{item.statusColor}}">
          <image wx:if="{{item.statusIcon}}" class="status-icon" src="/images/home/{{item.statusIcon}}.svg" mode="aspectFit" />
          <text class="status-text">{{item.statusLabel}}</text>
        </view>
      </view>

      <view class="card-divider"></view>

      <!-- 地址 -->
      <view class="addr-row">
        <image class="row-icon" src="/images/home/pin.svg" mode="aspectFit" />
        <text class="addr-text">{{item.addressText}}</text>
      </view>

      <!-- 预约时间 -->
      <view class="time-row">
        <image class="row-icon row-icon-clock" src="/images/home/clock-green.svg" mode="aspectFit" />
        <text class="time-text">{{item.appointText}}</text>
        <text class="category-inline" wx:if="{{item.categoryText}}">{{item.categoryText}}</text>
      </view>

    </view>

    <!-- 加载更多 -->
    <view wx:if="{{list.length && loading}}" class="load-tip">加载中...</view>
    <view wx:elif="{{list.length && !hasMore}}" class="load-tip">没有更多了</view>
  </view>
</view>
