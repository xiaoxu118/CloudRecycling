page {
  background: #f6f7f8;
}

.page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 56rpx 36rpx;
  text-align: center;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.06);
}

.icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 28rpx;
  border-radius: 50%;
  background: #07c160;
  position: relative;
}

.icon::after {
  content: "";
  position: absolute;
  left: 32rpx;
  top: 24rpx;
  width: 24rpx;
  height: 42rpx;
  border: solid #ffffff;
  border-width: 0 8rpx 8rpx 0;
  transform: rotate(45deg);
}

.icon.loading {
  background: #1677ff;
}

.icon.error {
  background: #e64340;
}

.icon.error::before,
.icon.error::after {
  content: "";
  position: absolute;
  left: 44rpx;
  top: 24rpx;
  width: 8rpx;
  height: 48rpx;
  background: #ffffff;
  border: 0;
}

.icon.error::before {
  transform: rotate(45deg);
}

.icon.error::after {
  transform: rotate(-45deg);
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 18rpx;
}

.message {
  font-size: 28rpx;
  line-height: 1.6;
  color: #4b5563;
  margin-bottom: 48rpx;
}

.openid {
  margin: 0 0 40rpx;
  padding: 24rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  text-align: left;
}

.openid-label {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.openid-value {
  display: block;
  font-size: 24rpx;
  color: #111827;
  word-break: break-all;
}

.copy-btn {
  margin-top: 20rpx;
  font-size: 26rpx;
}

.primary-btn {
  background: #07c160;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.plain-btn {
  margin-top: 24rpx;
  background: #ffffff;
  color: #4b5563;
  border-radius: 12rpx;
  font-size: 30rpx;
}
