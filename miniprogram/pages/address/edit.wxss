/* 地址编辑 */
.addr-edit {
  min-height: 100vh;
  background: #f6f6f6;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}
/* 地图选点入口 */
.map-pick {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  font-size: 30rpx;
  color: #07c160;
}
.map-icon {
  margin-right: 12rpx;
  font-size: 34rpx;
}
.map-text {
  flex: 1;
}
.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 32rpx;
}
.form-row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-row:last-child {
  border-bottom: none;
}
.label {
  width: 160rpx;
  font-size: 30rpx;
  color: #333;
}
.input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}
.input.placeholder {
  color: #999;
}
.arrow {
  color: #ccc;
  font-size: 36rpx;
}
.save-btn {
  width: calc(100% - 16rpx);
  height: 104rpx;
  margin: 48rpx 8rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2da460;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1;
  border-radius: 52rpx;
  box-shadow: 0 12rpx 24rpx rgba(45, 164, 96, 0.22);
}
.save-btn::after {
  border: none;
}
.save-btn:active {
  background: #258f52;
  transform: scale(0.985);
}
.save-btn[loading] {
  opacity: 0.72;
}
