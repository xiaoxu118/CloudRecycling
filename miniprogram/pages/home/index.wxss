/* 首页 */
.home {
  min-height: 100vh;
  background: #f5f7f5;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ============ 顶部自定义导航栏 ============ */
.top-bar {
  background: #ffffff;
  position: relative;
  z-index: 10;
}
.top-bar-inner {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
}
.location {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}
.loc-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.loc-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  max-width: 420rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.loc-arrow {
  width: 20rpx;
  height: 20rpx;
  margin-left: 6rpx;
  flex-shrink: 0;
}

/* ============ Banner ============ */
.banner {
  position: relative;
  height: 400rpx;
  overflow: hidden;
}
.banner-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}
.banner-bg-fallback {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  background: linear-gradient(135deg, #2da460 0%, #3cbf7a 60%, #52d08b 100%);
}
.banner-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  background: linear-gradient(180deg, rgba(0,0,0,0.12) 0%, rgba(0,0,0,0.05) 40%, rgba(0,0,0,0.2) 100%);
}
.banner-content {
  position: relative;
  z-index: 2;
  padding: 56rpx 48rpx 0;
  color: #fff;
}
.banner-logo {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.banner-logo-icon {
  width: 52rpx;
  height: 52rpx;
  margin-right: 14rpx;
}
.banner-title {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #fff;
}
.banner-slogan {
  font-size: 32rpx;
  color: #fff;
  opacity: 0.95;
  margin-bottom: 10rpx;
  font-weight: 500;
}
.banner-sub-slogan {
  font-size: 26rpx;
  color: #fff;
  opacity: 0.85;
}
.banner-cta {
  position: absolute;
  right: 40rpx;
  bottom: 40rpx;
  z-index: 3;
  padding: 16rpx 34rpx;
  background: rgba(255, 255, 255, 0.3);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 999rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

/* ============ 通用卡片 section ============ */
.section {
  margin: 24rpx 24rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-sizing: border-box;
}
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.section-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.section-hint {
  font-size: 26rpx;
  color: #999;
}

/* ============ 品类区 ============ */
.cat-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  column-gap: 16rpx;
  row-gap: 24rpx;
}
.cat-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 8rpx 20rpx;
  border-radius: 20rpx;
  background: #fafafa;
  border: 1rpx solid #ececec;
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}
.cat-item:active { transform: scale(0.96); }
.cat-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #ececec;
}
.cat-name {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #1f1f23;
  font-weight: 500;
  letter-spacing: -0.2rpx;
}
.cat-price {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #9ca3af;
  line-height: 1.2;
}
.cat-item.selected {
  background: #ebf7f1;
  border-color: #0f9f6e;
}
.cat-item.selected .cat-icon-wrap {
  background: #ffffff;
  border-color: #0f9f6e;
}
.cat-item.selected .cat-name {
  color: #0f9f6e;
  font-weight: 600;
}
.cat-check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0f9f6e;
  border-radius: 50%;
}

/* 预约按钮 */
.book-btn {
  margin: 20rpx -12rpx 0;
  width: calc(100% + 24rpx);
  height: 104rpx;
  line-height: 104rpx;
  background: #2da460;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  border-radius: 52rpx;
  letter-spacing: 4rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.book-btn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 14rpx;
  vertical-align: middle;
}
.book-btn::after {
  border: none;
}
/* ============ 服务承诺 ============ */
.service-title {
  margin-bottom: 28rpx;
  display: block;
}
.service-grid {
  display: flex;
  justify-content: space-between;
}
.service-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.svc-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #e8f6ee;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.svc-icon {
  width: 44rpx;
  height: 44rpx;
}
.svc-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 6rpx;
}
.svc-desc {
  font-size: 22rpx;
  color: #999;
}

/* ============ 客服热线 ============ */
.service-hotline {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}
.hotline-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #2da460;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.hotline-icon {
  width: 36rpx;
  height: 36rpx;
}
.hotline-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-right: 12rpx;
}
.hotline-time {
  font-size: 24rpx;
  color: #999;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.hotline-number {
  font-size: 32rpx;
  font-weight: 700;
  color: #2da460;
  margin-right: 10rpx;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}
.hotline-arrow {
  width: 20rpx;
  height: 20rpx;
  flex-shrink: 0;
}

.bottom-space {
  height: calc(60rpx + env(safe-area-inset-bottom));
}
