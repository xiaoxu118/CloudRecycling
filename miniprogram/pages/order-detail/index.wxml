<!--订单详情-->
<view class="order-detail" wx:if="{{order}}">
  <!-- 1. 订单进度 -->
  <view class="progress" wx:if="{{step > 0}}">
    <view class="step {{step > index ? 'done' : ''}} {{step === index + 1 ? 'current' : ''}}" wx:for="{{steps}}" wx:key="*this">
      <view class="dot">{{index + 1}}</view>
      <view class="step-label">{{item}}</view>
    </view>
  </view>

  <!-- 取消原因 -->
  <view class="block reject" wx:if="{{order.status === 'canceled' && order.cancelReason}}">
    <view class="block-title">取消原因</view>
    <view class="reject-text">{{order.cancelReason}}</view>
  </view>

  <!-- 2. 上门地址 -->
  <view class="block">
    <view class="block-title">上门地址</view>
    <view class="addr-line">{{order.addressSnapshot.contactName}} {{order.addressSnapshot.phone}}</view>
    <view class="addr-detail">{{order.addressSnapshot.region}} {{order.addressSnapshot.detail}}</view>
  </view>

  <!-- 3. 物品信息和照片 -->
  <view class="block">
    <view class="block-title">物品信息</view>
    <block wx:if="{{order.items && order.items.length}}">
      <view class="item-row" wx:for="{{order.items}}" wx:key="categoryId">
        <text class="item-name">{{item.categoryName}}</text>
        <text class="item-qty" wx:if="{{item.estCount > 0}}">{{item.estCount}} 件</text>
        <text class="item-qty" wx:elif="{{item.estWeight > 0}}">{{item.estWeight}} kg</text>
      </view>
    </block>
    <view class="item-empty" wx:else>未指定品类，以上门确认结果为准</view>

    <view class="goods-photos" wx:if="{{order.photoUrls && order.photoUrls.length}}">
      <view class="photo-title">物品照片（{{order.photoUrls.length}}）</view>
      <view class="photo-grid">
        <image
          class="photo-img"
          wx:for="{{order.photoUrls}}"
          wx:key="index"
          src="{{item}}"
          mode="aspectFill"
          data-index="{{index}}"
          bind:tap="previewPhoto"
        />
      </view>
    </view>
  </view>

  <!-- 4. 预约时间、订单号和备注 -->
  <view class="block">
    <view class="info-row"><text class="k">预约时间</text><text class="v">{{order.appointDate}} {{order.appointSlot}}</text></view>
    <view class="info-row"><text class="k">订单号</text><text class="v order-number">{{order.orderNo}}</text></view>
    <view class="info-row" wx:if="{{order.remark}}"><text class="k">备注</text><text class="v">{{order.remark}}</text></view>
  </view>

  <!-- 5. 待处理订单操作 -->
  <view class="cancel-action" wx:if="{{canCancel}}">
    <van-button
      type="danger"
      plain
      round
      block
      custom-class="cancel-vant-btn"
      bind:click="onCancel"
    >
      取消订单
    </van-button>
  </view>

  <!-- 金额 -->
  <view class="block" wx:if="{{order.hasAmountInfo}}">
    <view class="block-title">回收金额</view>
    <view class="info-row" wx:if="{{order.hasEstimatePrice}}"><text class="k">平台估价</text><text class="v price">¥{{order.estimatePrice}}</text></view>
    <view class="info-row" wx:if="{{order.hasFinalWeight}}"><text class="k">实际重量</text><text class="v">{{order.finalWeight}} kg</text></view>
    <view class="info-row" wx:if="{{order.hasFinalCount}}"><text class="k">实际件数</text><text class="v">{{order.finalCount}} 件</text></view>
    <view class="info-row" wx:if="{{order.hasFinalPrice}}"><text class="k">最终金额</text><text class="v price">¥{{order.finalPrice}}</text></view>
  </view>

  <view class="block" wx:if="{{order.recyclerName || order.recyclerPhone || order.adminRemark || order.completedAt || order.canceledAt}}">
    <view class="block-title">处理记录</view>
    <view class="info-row" wx:if="{{order.recyclerName}}"><text class="k">回收人员</text><text class="v">{{order.recyclerName}}</text></view>
    <view class="info-row" wx:if="{{order.recyclerPhone}}"><text class="k">联系电话</text><text class="v">{{order.recyclerPhone}}</text></view>
    <view class="info-row" wx:if="{{order.completedAtText}}"><text class="k">完成时间</text><text class="v">{{order.completedAtText}}</text></view>
    <view class="info-row" wx:if="{{order.canceledAtText}}"><text class="k">取消时间</text><text class="v">{{order.canceledAtText}}</text></view>
    <view class="info-row column" wx:if="{{order.adminRemark}}"><text class="k">处理备注</text><text class="v">{{order.adminRemark}}</text></view>
  </view>

  <!-- 打款截图 -->
  <view class="block" wx:if="{{order.transferProofUrls && order.transferProofUrls.length}}">
    <view class="block-title">打款截图</view>
    <view class="photo-grid">
      <image
        class="photo-img"
        wx:for="{{order.transferProofUrls}}"
        wx:key="index"
        src="{{item}}"
        mode="aspectFill"
        data-index="{{index}}"
        bind:tap="previewTransfer"
      />
    </view>
  </view>

</view>

<view class="state-tip" wx:elif="{{loading}}">加载中...</view>
