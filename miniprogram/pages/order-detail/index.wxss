/* 订单详情 */
.order-detail {
  min-height: 100vh;
  background: #f6f6f6;
  padding-bottom: 48rpx;
}
.state-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding-top: 200rpx;
}

/* 进度条 */
.progress {
  display: flex;
  background: #fff;
  padding: 40rpx 20rpx;
  margin: 24rpx;
  border-radius: 16rpx;
}
.step {
  flex: 1;
  text-align: center;
  position: relative;
}
.step .dot {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 50%;
  background: #e5e5e5;
  color: #fff;
  font-size: 26rpx;
  margin: 0 auto;
}

.cancel-action {
  margin: 20rpx 24rpx;
  padding: 0 24rpx;
}
.cancel-vant-btn {
  height: 80rpx !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  border-width: 2rpx !important;
}
.step.done .dot,
.step.current .dot {
  background: #07c160;
}
.step-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}
.step.done .step-label,
.step.current .step-label {
  color: #07c160;
}
/* 连接线 */
.step::before {
  content: "";
  position: absolute;
  top: 24rpx;
  left: -50%;
  width: 100%;
  height: 4rpx;
  background: #e5e5e5;
  z-index: 0;
}
.step:first-child::before {
  display: none;
}
.step.done::before {
  background: #07c160;
}
.step .dot {
  position: relative;
  z-index: 1;
}

/* 通用 block */
.block {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
}
.block-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}
.reject .reject-text {
  font-size: 30rpx;
  color: #e64340;
}

.item-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
}
.item-name {
  font-size: 30rpx;
  color: #333;
}
.item-qty {
  font-size: 30rpx;
  color: #666;
}
.item-empty {
  padding: 8rpx 0 16rpx;
  font-size: 27rpx;
  color: #999;
}

.goods-photos {
  margin-top: 20rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}
.photo-title {
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
}
.photo-img {
  width: 200rpx;
  height: 200rpx;
  margin: 8rpx;
  border-radius: 12rpx;
}

.addr-line {
  font-size: 32rpx;
  color: #333;
}
.addr-detail {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #666;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
}
.info-row.column {
  display: block;
}
.info-row.column .v {
  display: block;
  margin-top: 10rpx;
  line-height: 1.5;
}
.info-row .k {
  font-size: 28rpx;
  color: #999;
}
.info-row .v {
  font-size: 28rpx;
  color: #333;
}
.info-row .v.price {
  color: #e64340;
  font-weight: bold;
}
.order-number {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 26rpx !important;
  color: #666 !important;
}
