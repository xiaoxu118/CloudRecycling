.user-page {
  min-height: 100vh;
  padding: 28rpx 0 calc(80rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f5f7f5;
}

.profile-card {
  display: flex;
  align-items: center;
  margin: 0 24rpx;
  padding: 38rpx 32rpx;
  border-radius: 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #168f58 0%, #2daf69 100%);
  box-shadow: 0 16rpx 36rpx rgba(29, 145, 88, 0.2);
}

.avatar-button {
  position: relative;
  width: 116rpx;
  height: 116rpx;
  margin: 0;
  padding: 0;
  flex-shrink: 0;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
}
.avatar-button::after { border: none; }
.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
  background: #fff;
}
.avatar-edit {
  position: absolute;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  background: #166d47;
}
.profile-main {
  min-width: 0;
  margin-left: 26rpx;
  flex: 1;
}
.nickname-input {
  width: 100%;
  height: 54rpx;
  padding: 0;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}
.profile-sub {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  color: #e3f6eb;
  font-size: 25rpx;
  line-height: 1.5;
}

.stats-card {
  display: flex;
  align-items: center;
  margin: 22rpx 24rpx 0;
  padding: 28rpx 0;
  border: 1rpx solid #e8eee9;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(20, 60, 38, 0.05);
}
.stat-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}
.stat-value {
  color: #1c9b5f;
  font-size: 38rpx;
  font-weight: 700;
}
.stat-label {
  margin-top: 7rpx;
  color: #778179;
  font-size: 25rpx;
}
.stat-divider {
  width: 1rpx;
  height: 58rpx;
  background: #e7ece8;
}

.section-title {
  margin: 32rpx 40rpx 14rpx;
  color: #8b948d;
  font-size: 25rpx;
}
.menu-group {
  overflow: hidden;
  border: 1rpx solid #e8eee9;
  border-radius: 24rpx !important;
  box-shadow: 0 6rpx 20rpx rgba(20, 60, 38, 0.04);
}

.logout-wrap {
  margin: 48rpx 56rpx 0;
}
.logout-button {
  height: 82rpx !important;
  font-size: 28rpx !important;
}

.login-card {
  display: flex;
  min-height: calc(100vh - 56rpx);
  padding: 0 60rpx;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.login-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 148rpx;
  height: 148rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #e6f7ed, #ccefdc);
  box-shadow: 0 18rpx 40rpx rgba(30, 150, 92, 0.16);
}
.login-logo image {
  width: 82rpx;
  height: 82rpx;
}
.login-title {
  margin-top: 46rpx;
  color: #202722;
  font-size: 40rpx;
  font-weight: 700;
}
.login-sub {
  margin-top: 14rpx;
  color: #8b948d;
  font-size: 27rpx;
}
.login-button {
  width: 100% !important;
  height: 92rpx !important;
  margin-top: 72rpx;
  border-color: #20a362 !important;
  background: #20a362 !important;
  font-size: 31rpx !important;
  font-weight: 600 !important;
  box-shadow: 0 14rpx 28rpx rgba(32, 163, 98, 0.2);
}
.login-legal {
  margin-top: 26rpx;
  color: #a3aaa5;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}
