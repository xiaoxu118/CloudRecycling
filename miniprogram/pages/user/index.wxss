.user {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 80rpx;
}

/* --- Header --- */
.header {
  display: flex;
  align-items: center;
  padding: 60rpx 40rpx 40rpx;
  background: var(--bg);
}
.avatar-btn {
  padding: 0;
  background: transparent;
  line-height: 1;
}
.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--surface);
  border: 1rpx solid var(--border);
}
.header-text {
  margin-left: 28rpx;
  flex: 1;
  min-width: 0;
}
.nickname-input {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: -0.3rpx;
  min-height: 56rpx;
  padding: 0;
}
.header-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.header-sub .muted { color: var(--text-tertiary); }

/* --- List group --- */
.group {
  margin: 0 24rpx;
  overflow: hidden;
}
.row-btn {
  width: 100%;
  border-radius: 0;
  text-align: left;
  padding: 28rpx 32rpx;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  background: var(--surface);
  color: var(--text);
  font-size: 30rpx;
  font-weight: 400;
  border-top: 1rpx solid var(--border);
}
.openid-value {
  font-size: 22rpx;
  color: var(--text-tertiary);
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* --- Footer --- */
.footer {
  padding: 60rpx 40rpx 0;
  display: flex;
  justify-content: center;
}
.logout {
  color: var(--danger);
  font-size: 28rpx;
  padding: 20rpx 40rpx;
}

/* --- Login screen --- */
.login {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  background: var(--bg);
}
.login-title {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  color: var(--text);
}
.login-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--text-tertiary);
}
.login-btn {
  width: 100%;
  margin-top: 120rpx;
}
.login-legal {
  margin-top: 32rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.6;
}
