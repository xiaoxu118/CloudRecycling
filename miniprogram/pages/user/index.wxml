<view class="user-page">
  <!-- 已登录 -->
  <block wx:if="{{loggedIn}}">
    <view class="profile-card">
      <button class="avatar-button" open-type="chooseAvatar" bind:chooseavatar="onChangeAvatar">
        <image class="avatar" src="{{avatarUrl || '/images/icons/avatar.png'}}" mode="aspectFill" />
        <view class="avatar-edit"><van-icon name="photograph" size="22rpx" color="#fff" /></view>
      </button>
      <view class="profile-main">
        <input
          class="nickname-input"
          type="nickname"
          placeholder="点击设置昵称"
          value="{{nickName}}"
          bind:blur="onChangeNickInput"
        />
        <view class="profile-sub">
          <text>{{phone || '微信用户'}}</text>
        </view>
      </view>
      <van-icon name="edit" size="34rpx" color="rgba(255,255,255,.78)" />
    </view>

    <view class="stats-card">
      <view class="stat-item" bind:tap="goOrders">
        <text class="stat-value">{{orderCount || 0}}</text>
        <text class="stat-label">我的订单</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bind:tap="goAddress">
        <text class="stat-value">{{addressCount || 0}}</text>
        <text class="stat-label">常用地址</text>
      </view>
    </view>

    <view class="section-title">常用服务</view>
    <van-cell-group inset custom-class="menu-group">
      <van-cell title="我的订单" value="{{orderCount || 0}} 笔" icon="orders-o" is-link bind:click="goOrders" />
      <van-cell title="地址管理" value="{{addressCount || 0}} 个" icon="location-o" is-link bind:click="goAddress" />
    </van-cell-group>

    <view class="section-title">更多</view>
    <van-cell-group inset custom-class="menu-group">
      <van-cell title="关于云回收" icon="info-o" is-link bind:click="onAbout" />
      <van-cell wx:if="{{openid}}" title="用户 ID" value="点击复制" icon="idcard" is-link bind:click="onCopyOpenid" />
    </van-cell-group>

    <view class="logout-wrap">
      <van-button type="danger" plain round block custom-class="logout-button" bind:click="onLogout">
        退出登录
      </van-button>
    </view>
  </block>

  <!-- 未登录 -->
  <block wx:else>
    <view class="login-card">
      <view class="login-logo">
        <image src="/images/home/recycle.svg" mode="aspectFit" />
      </view>
      <view class="login-title">欢迎使用帮帮回收</view>
      <view class="login-sub">登录后管理预约订单和上门地址</view>
      <van-button
        type="primary"
        round
        block
        loading="{{loading}}"
        loading-text="登录中..."
        custom-class="login-button"
        bind:click="onWechatLogin"
      >
        微信一键登录
      </van-button>
      <view class="login-legal">登录仅用于识别当前微信用户和隔离个人订单数据</view>
    </view>
  </block>
</view>
