/* ---------- Design tokens (Apple / Notion / Linear inspired) ---------- */
page {
  --bg: #f5f5f7;
  --surface: #ffffff;
  --surface-2: #fafafa;
  --border: #ececec;
  --border-strong: #d9d9dc;
  --text: #0a0a0a;
  --text-secondary: #52525b;
  --text-tertiary: #9ca3af;
  --text-quaternary: #c4c4c8;
  --accent: #0f9f6e;
  --accent-soft: #ebf7f1;
  --danger: #e5484d;
  --warning: #d97706;
  --info: #2563eb;

  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 20rpx;
  --radius-xl: 28rpx;
  --radius-pill: 999rpx;

  --shadow-1: 0 1rpx 2rpx rgba(0, 0, 0, 0.04);

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text",
    "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* Reset default weixin button */
button {
  background: initial;
  padding: 0;
  margin: 0;
  line-height: normal;
  font-size: inherit;
  color: inherit;
}
button::after { border: none; }
button:focus { outline: 0; }

.container {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  box-sizing: border-box;
}

/* ---------- Reusable primitives ---------- */
.card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--border);
}
.divider {
  height: 1rpx;
  background: var(--border);
}
.chevron {
  color: var(--text-quaternary);
  font-size: 32rpx;
  line-height: 1;
}
.muted { color: var(--text-tertiary); }
.subtle { color: var(--text-secondary); }
.mono { font-family: "SF Mono", ui-monospace, Menlo, monospace; }

/* Primary CTA */
.btn-primary {
  background: var(--text);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: 30rpx;
  font-weight: 500;
  padding: 22rpx 40rpx;
  text-align: center;
  transition: opacity 0.15s ease;
}
.btn-primary[disabled],
.btn-primary.is-loading { opacity: 0.5; }
.btn-primary::after { border: none; }

.btn-secondary {
  background: var(--surface);
  color: var(--text);
  border: 1rpx solid var(--border-strong);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  padding: 20rpx 36rpx;
  text-align: center;
}

.btn-ghost {
  background: transparent;
  color: var(--text-secondary);
  font-size: 26rpx;
}

/* Page header (Notion-style large title) */
.page-title {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  color: var(--text);
  padding: 48rpx 40rpx 12rpx;
}
.page-subtitle {
  font-size: 26rpx;
  color: var(--text-tertiary);
  padding: 0 40rpx 32rpx;
}

/* Row (Notion / iOS Settings list) */
.row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  min-height: 96rpx;
  background: var(--surface);
}
.row + .row { border-top: 1rpx solid var(--border); }
.row-label {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
}
.row-value {
  font-size: 28rpx;
  color: var(--text-tertiary);
  margin-right: 12rpx;
  text-align: right;
}

/* Section label (Linear vibe) */
.section-label {
  padding: 32rpx 40rpx 12rpx;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  color: var(--text-tertiary);
}
